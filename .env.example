# Скопируйте в .env и заполните. Файл .env не коммитится.

DATABASE_URL=postgresql+psycopg://notification_user:notification_password@postgres:5432/notification_db
REDIS_URL=redis://redis:6379/0
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//

# Telegram: токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# JWT: сгенерируйте командой  openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
